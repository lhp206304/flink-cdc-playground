# ===== PostgreSQL（CDC 源库 + 维表库）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=ecommerce

# CDC 专用账号（有 replication 属性）
POSTGRES_CDC_USER=cdc_user
POSTGRES_CDC_PASSWORD=cdc_pass

# 维表查询账号（复用 CDC 账号，已有 base schema SELECT 权限）
POSTGRES_DIM_USER=cdc_user
POSTGRES_DIM_PASSWORD=cdc_pass

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=flink-cdc-pipeline
# DLQ topic：反序列化失败的原始消息写入此 topic
KAFKA_DLQ_TOPIC=dlq.cdc

# ===== Iceberg =====
ICEBERG_CATALOG_NAME=local_catalog
ICEBERG_WAREHOUSE_PATH=./warehouse
ICEBERG_DEFAULT_DATABASE=dwd

# ===== Flink Checkpoint =====
CHECKPOINT_INTERVAL_MS=3000
CHECKPOINT_MIN_PAUSE_MS=1000
CHECKPOINT_TIMEOUT_MS=60000
CHECKPOINT_TOLERABLE_FAILURES=3
RESTART_ATTEMPTS=3
RESTART_DELAY_SECONDS=10

# ===== Flink 部署模式 =====
# 部署目标：local（本地 MiniCluster，IDE 直接运行）/ remote（提交到远程 Flink 集群）
FLINK_DEPLOY_TARGET=local
# 以下两项仅在 FLINK_DEPLOY_TARGET=remote 时需要
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081

# ===== 数据生成器 =====
# Kafka 事件生成器
# 格式：topic:速率,topic:速率（速率单位：条/秒）
# 事件分布：点击 50% / 订单 30% / 价格变更 20%
GENERATOR_TOPICS=orders:30,clicks:50,product_price:20
GENERATOR_DURATION_SECONDS=-1

# Kafka 脏数据概率（0.0 ~ 1.0）
DUPLICATE_KEY_PROBABILITY=0.1
LATE_ARRIVAL_PROBABILITY=0.05
SCHEMA_EVOLUTION_PROBABILITY=0.3
HOT_REGION_PROBABILITY=0.0

# PostgreSQL 数据生成器
PG_GENERATOR_TPS=100
PG_GENERATOR_DURATION_SECONDS=-1
PG_INSERT_RATIO=0.7
PG_UPDATE_RATIO=0.2
PG_DELETE_RATIO=0.1
PG_TABLES=orders,order_items,users,products,payments
